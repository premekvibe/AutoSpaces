    LTEXT           T(APP_NAME), 201, 42, 9, 248, 16
    LTEXT           "", 202, 42, 27, 248, 10
    LTEXT           T(ABOUT_SUMMARY), 203, 10, 46, 280, 20
    LTEXT           T(ABOUT_AUTHOR), 204, 10, 70, 280, 10
    CONTROL         "", 205, "SysLink", WS_TABSTOP, 10, 82, 280, 10
