#pragma code_page(65001)

// Dialog templates, included once per language from autospaces.rc (texts: strings-<lang>.inc).
// Dialog and control IDs must match src/settings_dlg.rs. RC cuts control texts at 256 characters, so the two long
// paragraphs (ids 142 and 173) are set at run time from the string table in src/i18n.rs.
101 DIALOGEX 0, 0, 304, 346
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION T(SET_CAPTION)
FONT 9, "MS Shell Dlg", 400, 0, 1
BEGIN
    GROUPBOX        T(SET_GRP_TRIGGER), -1, 6, 4, 292, 58
    AUTORADIOBUTTON T(SET_MODE_ALL), 110, 14, 17, 278, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON T(SET_MODE_FS), 111, 14, 31, 278, 10
    AUTOCHECKBOX    T(SET_ARRANGE), 134, 14, 45, 278, 10, WS_TABSTOP

    GROUPBOX        T(SET_GRP_EXCL), -1, 6, 66, 292, 72
    LISTBOX         120, 14, 78, 192, 54, LBS_NOTIFY | LBS_SORT | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      T(BTN_ADD_RUNNING), 121, 212, 78, 80, 14
    PUSHBUTTON      T(BTN_REMOVE), 122, 212, 96, 80, 14

    GROUPBOX        T(SET_GRP_LEARNED), -1, 6, 142, 292, 72
    LISTBOX         130, 14, 154, 192, 40, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      T(BTN_REMOVE), 131, 212, 154, 80, 14
    AUTOCHECKBOX    T(SET_LEARNING), 132, 14, 198, 204, 10, WS_TABSTOP

    GROUPBOX        T(SET_GRP_SYSTEM), -1, 6, 218, 292, 102
    AUTOCHECKBOX    T(SET_AUTOSTART), 140, 14, 230, 278, 10, WS_TABSTOP
    PUSHBUTTON      T(SET_OPEN_WINSET), 141, 14, 246, 120, 14
    LTEXT           T(SET_LANG_LABEL), 145, 140, 249, 68, 10
    COMBOBOX        144, 210, 246, 82, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", 142, 14, 264, 278, 40
    LTEXT           T(SET_LANG_NOTE), 146, 14, 306, 278, 10

    PUSHBUTTON      T(SET_LAYOUT_BTN), 143, 6, 326, 100, 14, WS_TABSTOP
    DEFPUSHBUTTON   T(BTN_OK), 1, 190, 326, 50, 14
    PUSHBUTTON      T(BTN_CANCEL), 2, 246, 326, 50, 14
END

