    GROUPBOX        T(ABOUT_GRP), 219, 6, 112, 288, 146
    AUTORADIOBUTTON T(PAY_REVOLUT), 215, 14, 124, 100, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON T(PAY_ACCOUNT), 216, 124, 124, 100, 10
    CONTROL         "", 208, "Static", SS_BITMAP | SS_CENTERIMAGE, 12, 138, 112, 114
    LTEXT           "", 209, 132, 138, 156, 22
    CONTROL         "", 220, "Static", SS_OWNERDRAW, 132, 165, 12, 12
    LTEXT           T(ABOUT_LN), 210, 148, 166, 140, 10
    LTEXT           "", 211, 132, 178, 156, 10
    PUSHBUTTON      T(ABOUT_COPY), 212, 132, 194, 110, 14, WS_TABSTOP
    PUSHBUTTON      T(ABOUT_WALLET), 213, 132, 212, 110, 14, WS_TABSTOP
    LTEXT           "", 214, 132, 230, 156, 22

    AUTOCHECKBOX    T(ABOUT_NEVER), 217, 6, 264, 232, 10, WS_TABSTOP
    LTEXT           T(ABOUT_NOTE), 218, 6, 277, 232, 20
    DEFPUSHBUTTON   T(ABOUT_CLOSE), 1, 244, 264, 50, 14, WS_TABSTOP
END

